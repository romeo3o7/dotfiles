alias ls='ls -a --color'
alias lsa='ls -alh --color'

alias gis='git status'
alias gic='git commit -a'

alias reload='source ~/.zshrc'
alias bp='cat /sys/class/power_supply/BAT1/capacity'
alias wan='netdig w'

alias iueaConnect='python ~/projects/python/pyhttp/iueaBrowserBypass.py'

alias v-record='wf-recorder --audio=alsa_output.pci-0000_03_00.6.analog-stereo.monitor \
	-c h264_vaapi -d /dev/dri/renderD128 -f /home/romeo/videos/recording/recording-$(date +%Y%m%d_%H%M%S).mkv'

alias removeTemp="rm -fr ~/.config/mozilla/firefox/jq48sp2g.default-release/storage/default/*userContextId=6*; \
sqlite3 ~/.config/mozilla/firefox/jq48sp2g.default-release/cookies.sqlite \"DELETE FROM moz_cookies WHERE originAttributes LIKE '%userContextId=6%';\" "
